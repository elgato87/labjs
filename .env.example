# Copiá este archivo a ".env" y completá los valores.
#   cp .env.example .env

# --- Imagen de JumpServer ---
# Community Edition (publica): sirve para probar la HA del tier de app + cluster Vault,
# pero NO tiene integracion con Vault externo.
JMS_IMAGE=jumpserver/jms_all:v4.10.17
# Enterprise Edition (requiere trial/licencia): necesaria para que VAULT_* tenga efecto.
# JMS_IMAGE=<imagen EE de tu trial, p.ej. registro privado>/jms_all:v4.10.17

# --- Claves compartidas por AMBOS nodos (deben ser identicas y fijas) ---
# Generalas asi:
#   SECRET_KEY:       openssl rand -hex 24      (48 chars)
#   BOOTSTRAP_TOKEN:  openssl rand -hex 12      (24 chars)
SECRET_KEY=CAMBIA_ESTO_48_CHARS_aaaaaaaaaaaaaaaaaaaaaaaaaaaa
BOOTSTRAP_TOKEN=CAMBIA_ESTO_24_CHARS_bbbb

# --- Credenciales de datos ---
DB_PASSWORD=CambiaEstaClaveDB
REDIS_PASSWORD=CambiaEstaClaveRedis

# --- Vault ---
# Dejalo en false para el primer arranque. Tras correr vault-init.sh y pegar el token,
# poné true y reiniciá los nodos JumpServer (solo tiene efecto con imagen EE).
VAULT_ENABLED=false
VAULT_HCP_TOKEN=
