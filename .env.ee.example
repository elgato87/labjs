# =============================================================================
# JUMPSERVER ENTERPRISE EDITION (.env.ee) - SERVICIOS EXTERNOS
# =============================================================================
# Copiar este archivo a ".env.ee" y completar los valores reales:
#   cp .env.ee.example .env.ee

# ------------------------- Seguridad JumpServer -------------------------
# Claves maestras únicas por instalación (deben ser consistentes en todos los nodos)
# Generar valores seguros con openssl:
#   SECRET_KEY:       openssl rand -hex 24   (48 caracteres)
#   BOOTSTRAP_TOKEN:  openssl rand -hex 12   (24 caracteres)
SECRET_KEY=CAMBIA_ESTO_48_CHARS_openssl_rand_hex_24
BOOTSTRAP_TOKEN=CAMBIA_ESTO_24_CHARS_openssl_rand_hex_12
LOG_LEVEL=ERROR

# ------------------------- PostgreSQL Externo -------------------------
# Base de datos relacional independiente
DB_ENGINE=postgresql
DB_HOST=192.168.10.50
DB_PORT=5432
DB_USER=jumpserver
DB_PASSWORD=CAMBIA_ESTA_CLAVE_POSTGRES
DB_NAME=jumpserver
# Si PostgreSQL requiere SSL:
# DB_USE_SSL=false

# ------------------------- Redis Externo -------------------------
# Broker de mensajería y caché independiente
REDIS_HOST=192.168.10.51
REDIS_PORT=6379
REDIS_PASSWORD=CAMBIA_ESTA_CLAVE_REDIS
# Si se usa Redis Sentinel (HA):
# REDIS_SENTINEL_HOSTS=mymaster/192.168.10.51:26379,192.168.10.52:26379,192.168.10.53:26379
# REDIS_SENTINEL_PASSWORD=sentinel_password

# ------------------------- HashiCorp Vault Externo -------------------------
# Cluster de Vault externo (requiere licencia/trial Enterprise de JumpServer)
VAULT_ENABLED=true
VAULT_BACKEND=hcp
VAULT_HCP_HOST=http://192.168.10.52:8200
VAULT_HCP_TOKEN=s.CAMBIA_POR_EL_TOKEN_DE_VAULT
VAULT_HCP_MOUNT_POINT=jumpserver

# ------------------------- Sesiones y Salas Compartidas -------------------------
SHARE_ROOM_TYPE=redis

# ------------------------- Web & Red -------------------------
HTTP_PORT=80
USE_LB=1
CLIENT_MAX_BODY_SIZE=4096m
# Dominios o IPs de confianza (separados por coma si son varios):
# DOMAINS=jumpserver.tu-empresa.com:80,192.168.10.10:80

